# Copy to .env at the repo root (loaded by the NestJS server).
# Port the server listens on (Caddy reverse-proxies to this).
PORT=3000
# Public origin of the site, e.g. https://example.com (ADR-0008). Enables the canonical
# link, og:url, absolute og:image, /sitemap.xml and the robots.txt Sitemap line.
# Leave unset until the domain is fixed: none of those are output.
# SITE_URL=
